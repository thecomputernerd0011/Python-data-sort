import numpy as np




def get_array():
    i = int(input("How many numbers are in your array?"))
    array = []
    count = 0
    while count < i:
            a = input("# ")
            new_array = np.append(array,a)
            array = new_array 
            count += 1
    print(array)
    return array

                                
def sort():
    sorted = np.sort(get_array(), kind = 'quicksort')
    return sorted
sorted = sort()
print(sorted)
